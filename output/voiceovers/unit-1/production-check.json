  "cues": [
    {
      "id": 1,
      "scene": 1,
      "text": "Welcome, detective! Let us use numbers to prepare our school fair.",
      "words": 11,
      "source_caption_start": 0.5,
      "source_caption_end": 5.8,
      "caption_start": 0.2,
      "caption_end": 5.861021,
      "speech_start": 0.21,
      "speech_end": 5.851020833333333,
      "wpm": 117,
      "raw_seconds": 5.9748125,
      "tempo_factor": 1.0591713068181816
    },
    {
      "id": 2,
      "scene": 2,
      "text": "Two hundreds, three tens, and six ones make two hundred thirty-six.",
      "words": 12,
      "source_caption_start": 6.8,
      "source_caption_end": 11.1,
      "caption_start": 6.2,
      "caption_end": 12.591687,
      "speech_start": 6.21,
      "speech_end": 12.5816875,
      "wpm": 113,
      "raw_seconds": 5.5165625,
      "tempo_factor": 0.8657938368055556
    },
    {
      "id": 3,
      "scene": 2,
      "text": "It is greater than two hundred thirty.",
      "words": 7,
      "source_caption_start": 11.4,
      "source_caption_end": 13.5,
      "caption_start": 12.731687,
      "caption_end": 16.4685,
      "speech_start": 12.7416875,
      "speech_end": 16.4585,
      "wpm": 113,
      "raw_seconds": 2.3171041666666667,
      "tempo_factor": 0.6234113591269842
    },
    {
      "id": 4,
      "scene": 2,
      "text": "Compare the place values, starting with the hundreds.",
      "words": 8,
      "source_caption_start": 13.9,
      "source_caption_end": 20.5,
      "caption_start": 16.6085,
      "caption_end": 20.876292,
      "speech_start": 16.6185,
      "speech_end": 20.866291666666665,
      "wpm": 113,
      "raw_seconds": 3.5813125,
      "tempo_factor": 0.8431006510416666
    },
    {
      "id": 5,
      "scene": 3,
      "text": "Addition joins amounts.",
      "words": 3,
      "source_caption_start": 21.6,
      "source_caption_end": 22.9,
      "caption_start": 21.2,
      "caption_end": 22.827146,
      "speech_start": 21.21,
      "speech_end": 22.817145833333335,
      "wpm": 112,
      "raw_seconds": 1.7409166666666667,
      "tempo_factor": 1.083237037037037
    },
    {
      "id": 6,
      "scene": 3,
      "text": "Twenty-seven plus fifteen is forty-two.",
      "words": 7,
      "source_caption_start": 23.2,
      "source_caption_end": 25.7,
      "caption_start": 22.967146,
      "caption_end": 26.737146,
      "speech_start": 22.977145833333335,
      "speech_end": 26.727145833333335,
      "wpm": 112,
      "raw_seconds": 2.9678541666666667,
      "tempo_factor": 0.7914277777777777
    },
    {
      "id": 7,
      "scene": 3,
      "text": "Exchange ten ones for one ten when needed.",
      "words": 8,
      "source_caption_start": 26.0,
      "source_caption_end": 29.3,
      "caption_start": 26.877146,
      "caption_end": 31.182854,
      "speech_start": 26.887145833333335,
      "speech_end": 31.172854166666667,
      "wpm": 112,
      "raw_seconds": 3.2215833333333332,
      "tempo_factor": 0.7517027777777778
    },
    {
      "id": 8,
      "scene": 3,
      "text": "Subtraction takes an amount away.",
      "words": 5,
      "source_caption_start": 29.6,
      "source_caption_end": 31.5,
      "caption_start": 31.322854,
      "caption_end": 34.021417,
      "speech_start": 31.332854166666667,
      "speech_end": 34.01141666666667,
      "wpm": 112,
      "raw_seconds": 2.320875,
      "tempo_factor": 0.8664600000000001
    },
    {
      "id": 9,
      "scene": 3,
      "text": "Forty-two minus fifteen returns us to twenty-seven.",
      "words": 9,
      "source_caption_start": 31.8,
      "source_caption_end": 35.7,
      "caption_start": 34.161417,
      "caption_end": 39.002854,
      "speech_start": 34.171416666666666,
      "speech_end": 38.99285416666667,
      "wpm": 112,
      "raw_seconds": 3.7737083333333334,
      "tempo_factor": 0.7826950617283951
    },
    {
      "id": 10,
      "scene": 3,
      "text": "The operations help check each other.",
      "words": 6,
      "source_caption_start": 36.0,
      "source_caption_end": 42.5,
      "caption_start": 39.142854,
      "caption_end": 42.377146,
      "speech_start": 39.152854166666664,
      "speech_end": 42.36714583333333,
      "wpm": 112,
      "raw_seconds": 2.3726458333333333,
      "tempo_factor": 0.7381564814814815
    },
    {
      "id": 11,
      "scene": 4,
      "text": "Three bags with five pencils each make fifteen pencils.",
      "words": 9,
      "source_caption_start": 43.5,
      "source_caption_end": 46.5,
      "caption_start": 43.2,
      "caption_end": 48.041438,
      "speech_start": 43.21,
      "speech_end": 48.0314375,
      "wpm": 112,
      "raw_seconds": 4.1120833333333335,
      "tempo_factor": 0.8528765432098766
    },
    {
      "id": 12,
      "scene": 4,
      "text": "That is multiplication: equal groups.",
      "words": 5,
      "source_caption_start": 46.8,
      "source_caption_end": 49.3,
      "caption_start": 48.181438,
      "caption_end": 50.88,
      "speech_start": 48.1914375,
      "speech_end": 50.87,
      "wpm": 112,
      "raw_seconds": 3.007041666666667,
      "tempo_factor": 1.1226288888888891
    },
    {
      "id": 13,
      "scene": 4,
      "text": "Sharing fifteen equally among three bags gives five each.",
      "words": 9,
      "source_caption_start": 49.6,
      "source_caption_end": 53.5,
      "caption_start": 51.02,
      "caption_end": 55.861438,
      "speech_start": 51.03,
      "speech_end": 55.8514375,
      "wpm": 112,
      "raw_seconds": 4.334958333333334,
      "tempo_factor": 0.8991024691358026
    },
    {
      "id": 14,
      "scene": 4,
      "text": "That is division.",
      "words": 3,
      "source_caption_start": 53.8,
      "source_caption_end": 55.5,
      "caption_start": 56.001438,
      "caption_end": 57.628583,
      "speech_start": 56.0114375,
      "speech_end": 57.61858333333333,
      "wpm": 112,
      "raw_seconds": 1.2393541666666668,
      "tempo_factor": 0.7711537037037037
    },
    {
      "id": 15,
      "scene": 4,
      "text": "Check that every bag has the same number.",
      "words": 8,
      "source_caption_start": 55.8,
      "source_caption_end": 62.5,
      "caption_start": 57.768583,
      "caption_end": 62.074292,
      "speech_start": 57.77858333333333,
      "speech_end": 62.06429166666667,
      "wpm": 112,
      "raw_seconds": 2.685604166666667,
      "tempo_factor": 0.6266409722222223
    },
    {
      "id": 16,
      "scene": 5,
      "text": "Multiples follow equal jumps.",
      "words": 4,
      "source_caption_start": 63.6,
      "source_caption_end": 65.5,
      "caption_start": 63.2,
      "caption_end": 65.362854,
      "speech_start": 63.21,
      "speech_end": 65.35285416666666,
      "wpm": 112,
      "raw_seconds": 2.238020833333333,
      "tempo_factor": 1.0444097222222222
    },
    {
      "id": 17,
      "scene": 5,
      "text": "Count in threes or fives.",
      "words": 5,
      "source_caption_start": 65.8,
      "source_caption_end": 68.5,
      "caption_start": 65.502854,
      "caption_end": 68.201417,
      "speech_start": 65.51285416666667,
      "speech_end": 68.19141666666667,
      "wpm": 112,
      "raw_seconds": 1.9608958333333333,
      "tempo_factor": 0.7320677777777778
    },
    {
      "id": 18,
      "scene": 5,
      "text": "Fifteen appears in both patterns, so one number can fit two rules.",
      "words": 12,
      "source_caption_start": 68.8,
      "source_caption_end": 75.5,
      "caption_start": 68.341417,
      "caption_end": 74.789979,
      "speech_start": 68.35141666666667,
      "speech_end": 74.77997916666666,
      "wpm": 112,
      "raw_seconds": 5.255625,
      "tempo_factor": 0.8175416666666667
    },
    {
      "id": 19,
      "scene": 6,
      "text": "Fractions describe equal parts of a whole.",
      "words": 7,
      "source_caption_start": 76.4,
      "source_caption_end": 79.3,
      "caption_start": 76.2,
      "caption_end": 79.904208,
      "speech_start": 76.21,
      "speech_end": 79.89420833333334,
      "wpm": 114,
      "raw_seconds": 2.8243958333333334,
      "tempo_factor": 0.7666217261904762
    },
    {
      "id": 20,
      "scene": 6,
      "text": "One of four parts is one quarter.",
      "words": 7,
      "source_caption_start": 79.6,
      "source_caption_end": 82.9,
      "caption_start": 80.044208,
      "caption_end": 83.748417,
      "speech_start": 80.05420833333334,
      "speech_end": 83.73841666666667,
      "wpm": 114,
      "raw_seconds": 2.302125,
      "tempo_factor": 0.6248625000000001
    },
    {
      "id": 21,
      "scene": 6,
      "text": "Two quarters make one half.",
      "words": 5,
      "source_caption_start": 83.2,
      "source_caption_end": 85.7,
      "caption_start": 83.888417,
      "caption_end": 86.54,
      "speech_start": 83.89841666666666,
      "speech_end": 86.53,
      "wpm": 114,
      "raw_seconds": 2.039270833333333,
      "tempo_factor": 0.7749229166666666
    },
    {
      "id": 22,
      "scene": 6,
      "text": "Three shaded parts make three quarters.",
      "words": 6,
      "source_caption_start": 86.0,
      "source_caption_end": 89.5,
      "caption_start": 86.68,
      "caption_end": 89.857896,
      "speech_start": 86.69,
      "speech_end": 89.84789583333334,
      "wpm": 114,
      "raw_seconds": 2.6903333333333332,
      "tempo_factor": 0.8519388888888888
    },
    {
      "id": 23,
      "scene": 7,
      "text": "Three thousand plus four thousand costs seven thousand rupiah.",
      "words": 9,
      "source_caption_start": 90.6,
      "source_caption_end": 94.9,
      "caption_start": 90.2,
      "caption_end": 95.041438,
      "speech_start": 90.21,
      "speech_end": 95.0314375,
      "wpm": 112,
      "raw_seconds": 4.367875,
      "tempo_factor": 0.9059296296296296
    },
    {
      "id": 24,
      "scene": 7,
      "text": "Pay ten thousand.",
      "words": 3,
      "source_caption_start": 95.2,
      "source_caption_end": 97.3,
      "caption_start": 95.181438,
      "caption_end": 96.808583,
      "speech_start": 95.1914375,
      "speech_end": 96.79858333333334,
      "wpm": 112,
      "raw_seconds": 1.4625625,
      "tempo_factor": 0.9100388888888888
    },
    {
      "id": 25,
      "scene": 7,
      "text": "How much change?",
      "words": 3,
      "source_caption_start": 97.7,
      "source_caption_end": 103.1,
      "caption_start": 96.948583,
      "caption_end": 102.495729,
      "speech_start": 96.95858333333334,
      "speech_end": 98.56572916666667,
      "wpm": 112,
      "raw_seconds": 1.3488541666666667,
      "tempo_factor": 0.839287037037037
    },
    {
      "id": 26,
      "scene": 7,
      "text": "Three thousand: subtract the cost from your payment.",
      "words": 8,
      "source_caption_start": 103.4,
      "source_caption_end": 108.3,
      "caption_start": 102.685729,
      "caption_end": 106.861438,
      "speech_start": 102.56572916666667,
      "speech_end": 106.8514375,
      "wpm": 112,
