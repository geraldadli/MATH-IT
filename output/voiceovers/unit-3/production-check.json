  "captions": [
    {
      "id": 1,
      "sentence_id": 1,
      "start": 0.5,
      "end": 4.18125,
      "text": "Our toolkit measures length, mass, and time,",
      "mode": "subtitle"
    },
    {
      "id": 2,
      "sentence_id": 1,
      "start": 4.18125,
      "end": 6.95,
      "text": "and helps us investigate shapes.",
      "mode": "subtitle"
    },
    {
      "id": 3,
      "sentence_id": 2,
      "start": 7.6,
      "end": 10.957645833333334,
      "text": "One meter is one hundred centimeters.",
      "mode": "subtitle"
    },
    {
      "id": 4,
      "sentence_id": 3,
      "start": 11.8,
      "end": 15.0128125,
      "text": "Half a meter is fifty centimeters.",
      "mode": "subtitle"
    },
    {
      "id": 5,
      "sentence_id": 4,
      "start": 15.6,
      "end": 19.435604166666664,
      "text": "Before adding lengths, use the same unit.",
      "mode": "subtitle"
    },
    {
      "id": 6,
      "sentence_id": 5,
      "start": 20.0,
      "end": 24.74375,
      "text": "Two meters and thirty centimeters\nbecomes two hundred plus thirty:",
      "mode": "subtitle"
    },
    {
      "id": 7,
      "sentence_id": 5,
      "start": 24.74375,
      "end": 27.490416666666665,
      "text": "two hundred thirty centimeters.",
      "mode": "subtitle"
    },
    {
      "id": 8,
      "sentence_id": 6,
      "start": 32.6,
      "end": 36.163291666666666,
      "text": "One kilogram is one thousand grams.",
      "mode": "subtitle"
    },
    {
      "id": 9,
      "sentence_id": 7,
      "start": 36.5,
      "end": 40.0088125,
      "text": "Half a kilogram is five hundred grams.",
      "mode": "subtitle"
    },
    {
      "id": 10,
      "sentence_id": 8,
      "start": 40.6,
      "end": 44.837312499999996,
      "text": "Change kilograms into grams before combining them.",
      "mode": "subtitle"
    },
    {
      "id": 11,
      "sentence_id": 9,
      "start": 46.2,
      "end": 49.50625,
      "text": "One kilogram plus two hundred fifty grams",
      "mode": "subtitle"
    },
    {
      "id": 12,
      "sentence_id": 9,
      "start": 49.50625,
      "end": 53.22052083333333,
      "text": "makes one thousand two hundred fifty grams.",
      "mode": "subtitle"
    },
    {
      "id": 13,
      "sentence_id": 10,
      "start": 54.6,
      "end": 57.434645833333335,
      "text": "An hour has sixty minutes.",
      "mode": "subtitle"
    },
    {
      "id": 14,
      "sentence_id": 11,
      "start": 57.6,
      "end": 60.7515,
      "text": "Count forward to find elapsed time.",
      "mode": "subtitle"
    },
    {
      "id": 15,
      "sentence_id": 12,
      "start": 61.2,
      "end": 65.295625,
      "text": "From nine forty to ten o’clock is twenty minutes.",
      "mode": "subtitle"
    },
    {
      "id": 16,
      "sentence_id": 13,
      "start": 66.8,
      "end": 70.59116666666667,
      "text": "Continue five more minutes to ten oh five.",
      "mode": "subtitle"
    },
    {
      "id": 17,
      "sentence_id": 14,
      "start": 71.8,
      "end": 75.63695833333334,
      "text": "Twenty plus five makes twenty-five minutes.",
      "mode": "subtitle"
    },
    {
      "id": 18,
      "sentence_id": 15,
      "start": 78.6,
      "end": 82.3125,
      "text": "A square has four equal sides and right angles,",
      "mode": "subtitle"
    },
    {
      "id": 19,
      "sentence_id": 15,
      "start": 82.3125,
      "end": 84.1781875,
      "text": "even when turned.",
      "mode": "subtitle"
    },
    {
      "id": 20,
      "sentence_id": 16,
      "start": 85.8,
      "end": 88.74145833333334,
      "text": "A right angle is a square corner.",
      "mode": "subtitle"
    },
    {
      "id": 21,
      "sentence_id": 17,
      "start": 90.0,
      "end": 94.92216666666667,
      "text": "This triangle has three equal sides and no right angle.",
      "mode": "subtitle"
    },
    {
      "id": 22,
      "sentence_id": 18,
      "start": 96.89522916666667,
      "end": 102.38000000000001,
      "text": "Does it fit either rule?",
      "mode": "subtitle"
    },
    {
      "id": 23,
      "sentence_id": 19,
      "start": 102.4,
      "end": 103.85979166666667,
      "text": "Neither.",
      "mode": "subtitle"
    },
    {
      "id": 24,
      "sentence_id": 20,
      "start": 105.5,
      "end": 108.7125,
      "text": "Match your units, count time carefully,",
      "mode": "subtitle"
    },
    {
      "id": 25,
      "sentence_id": 20,
      "start": 108.7125,
      "end": 113.30620833333334,
      "text": "and check shape properties instead of guessing from appearance.",
      "mode": "subtitle"
    },
    {
      "id": 26,
      "sentence_id": 21,
      "start": 113.8,
      "end": 117.80066666666667,
      "text": "Take your time, and try the Unit Three quizzes!",
      "mode": "subtitle"
    }
