      "end": 40.736604166666666,
      "duration_seconds": 1.8566041666666666,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 12,
      "text": "A missing number must make the equation true.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-04-1.mp3",
      "source_in": 0.12679166666666666,
