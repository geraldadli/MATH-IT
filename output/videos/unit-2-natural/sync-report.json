      "duration_seconds": 1.8246666666666667,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 2,
      "text": "Let us investigate five useful strategies.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-01-1.mp3",
      "source_in": 2.316625,
