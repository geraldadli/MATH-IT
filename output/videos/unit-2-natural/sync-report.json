      "duration_seconds": 3.8910625,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 14,
      "text": "For six times something equals thirty, divide.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-04-1.mp3",
      "source_in": 7.074541666666667,
