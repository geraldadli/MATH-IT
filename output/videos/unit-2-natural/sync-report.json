      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 16,
      "text": "Estimate with nearby tens.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-05-1.mp3",
      "source_in": 0.12879166666666667,
