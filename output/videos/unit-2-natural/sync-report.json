      "end": 46.713770833333335,
      "duration_seconds": 2.3337708333333333,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 13,
      "text": "Undo adding nine with subtraction: the missing number is fourteen.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-04-1.mp3",
      "source_in": 2.8185208333333334,
