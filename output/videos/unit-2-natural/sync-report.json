      "duration_seconds": 3.55025,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 18,
      "text": "Forty plus twenty makes sixty, so the total is about sixty.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-05-1.mp3",
      "source_in": 5.902833333333334,
