  "cues": [
    {
      "id": 1,
      "text": "Good detectives explain their thinking.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-01-1.mp3",
      "source_in": 0.12791666666666668,
