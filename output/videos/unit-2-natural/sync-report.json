      "duration_seconds": 2.4498333333333333,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 3,
      "text": "Picture the story.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-02-1.mp3",
      "source_in": 0.142125,
      "source_out": 0.944,
      "scene": 2,
      "caption_start": 6.4799999999999995,
      "caption_end": 7.8999999999999995,
      "start": 6.48,
      "end": 7.281875,
      "duration_seconds": 0.801875,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 4,
      "text": "Do things join, leave, repeat, or need comparing?",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-02-1.mp3",
      "source_in": 1.3163958333333334,
      "source_out": 4.9360625,
      "scene": 2,
      "caption_start": 8.08,
      "caption_end": 12.1,
      "start": 8.08,
      "end": 11.699666666666667,
      "duration_seconds": 3.619666666666667,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 5,
      "text": "Seventeen stickers compared with eleven means six more.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-02-1.mp3",
      "source_in": 5.309125,
      "source_out": 8.4589375,
      "scene": 2,
      "caption_start": 12.280000000000001,
      "caption_end": 16.700000000000003,
      "start": 12.28,
      "end": 15.4298125,
      "duration_seconds": 3.1498125,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 6,
      "text": "We subtract to find the difference.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-02-1.mp3",
      "source_in": 8.851916666666666,
      "source_out": 10.601833333333333,
      "scene": 2,
      "caption_start": 16.88,
      "caption_end": 20.1,
      "start": 16.88,
      "end": 18.629916666666666,
      "duration_seconds": 1.7499166666666666,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 7,
      "text": "The word more does not always mean add.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-02-1.mp3",
      "source_in": 10.999041666666667,
      "source_out": 12.901083333333334,
      "scene": 2,
      "caption_start": 20.279999999999998,
      "caption_end": 25.5,
      "start": 20.28,
      "end": 22.182041666666667,
      "duration_seconds": 1.9020416666666666,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 8,
      "text": "For a two-step clue, work inside the brackets first.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-03-1.mp3",
      "source_in": 0.13302083333333334,
      "source_out": 3.185375,
      "scene": 3,
      "caption_start": 26.48,
      "caption_end": 30.900000000000002,
      "start": 26.48,
      "end": 29.532354166666668,
      "duration_seconds": 3.0523541666666665,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 9,
      "text": "Five plus four makes nine.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-03-1.mp3",
      "source_in": 3.5816875,
      "source_out": 5.0296666666666665,
      "scene": 3,
      "caption_start": 31.08,
      "caption_end": 33.5,
      "start": 31.08,
      "end": 32.52797916666667,
      "duration_seconds": 1.4479791666666666,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 10,
      "text": "Replace the brackets with nine, then multiply by three.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-03-1.mp3",
      "source_in": 5.209645833333333,
      "source_out": 8.682041666666667,
      "scene": 3,
      "caption_start": 33.68,
      "caption_end": 38.7,
      "start": 33.68,
      "end": 37.15239583333334,
      "duration_seconds": 3.472395833333333,
      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 11,
      "text": "The final answer is twenty-seven.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-03-1.mp3",
      "source_in": 8.9295625,
      "source_out": 10.786166666666666,
      "scene": 3,
      "caption_start": 38.88,
      "caption_end": 43.5,
