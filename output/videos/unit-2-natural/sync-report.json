      "playback_speed": 1.0,
      "time_stretch": false
    },
    {
      "id": 17,
      "text": "Thirty-seven rounds to forty; twenty-four rounds to twenty.",
      "source_file": "D:\\Project-Website\\math-it\\output\\voiceovers\\unit-2\\microsoft-natural\\originals\\scene-05-1.mp3",
      "source_in": 2.0076666666666667,
